# FILE: .dockerignore
# Language: Dockerignore
# Root Docker context exclusions for source-only, secret-safe image builds.
# WE[ 	 	 			 		 				 		 				 		  	   		  	 	 		 			   	      	   	 	 		 			  		  			 		 	  	 		 			  		  	 	]WE

.git
.gitignore
.gitattributes
.github
.github/**

node_modules
node_modules/**
**/node_modules
.pnpm-store
.pnpm-store/**
.turbo
.turbo/**

.next
.next/**
**/.next
**/.next/**
dist
dist/**
**/dist
**/dist/**
build
build/**
**/build
**/build/**
coverage
coverage/**
**/coverage
**/coverage/**
*.tsbuildinfo
**/*.tsbuildinfo

.env
.env.*
**/.env
**/.env.*
*.env
**/*.env
!.env.example
!**/.env.example

cm_web.sql
*.sql
**/*.sql
*.dump
**/*.dump
*.backup
**/*.backup
*.tar
**/*.tar
*.tar.gz
**/*.tar.gz
*.tgz
**/*.tgz
*.zip
**/*.zip
review_diff_*
support/_snapshot.txt
support/_filelist.txt

mirror_key
mirror_key.pub
*.key
**/*.key
*.pem
**/*.pem
*.p12
**/*.p12
*.pfx
**/*.pfx

data
data/**

!src/lib/data
!src/lib/data/**

uploads
uploads/**
logs
logs/**
apps/web/public/tiles
apps/web/public/tiles/**
scripts/game-maps.txt

# WE[ 	 	 			 		 				 		 				 		  	   		  	 	 		 			   	      	   	 	 		 			  		  			 		 	  	 		 			  		  	 	]WE
