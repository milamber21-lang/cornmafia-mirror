!.env.example

*.sql
**/*.sql
*.dump
**/*.dump
*.backup
**/*.backup
*.tar
**/*.tar
*.tar.gz
**/*.tar.gz
*.tgz
**/*.tgz
*.zip
**/*.zip

public/tiles
public/tiles/**
data
data/**
uploads
uploads/**
