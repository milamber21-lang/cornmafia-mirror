# FILE: apps/web/.dockerignore
# Language: Dockerignore
# Web app Docker context exclusions for source-only, secret-safe image builds.
# WE[ 	 	 			 		 				 		 				 		  	   		  	 	 		 			   	      	   	 	 		 			  		  			 		 	  	 		 			  		  	 	]WE

node_modules
node_modules/**
dist
dist/**
.next
.next/**
.git
.git/**
.gitignore
.gitattributes
Dockerfile
*.log
.vscode
coverage
coverage/**

# Unit and contract tests run in CI, not in the production image build context.
vitest.config.ts
src/test
src/test/**
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx

.env
.env.*
*.env
!.env.example

*.sql
**/*.sql
*.dump
**/*.dump
*.backup
**/*.backup
*.tar
**/*.tar
*.tar.gz
**/*.tar.gz
*.tgz
**/*.tgz
*.zip
**/*.zip

public/tiles
public/tiles/**
data
data/**
uploads
uploads/**

# Keep app source data helpers in the Docker build context.
# The broad host-data exclusions above must not hide src/lib/data/* imports.
!src/lib/data
!src/lib/data/**

# WE[ 	 	 			 		 				 		 				 		  	   		  	 	 		 			   	      	   	 	 		 			  		  			 		 	  	 		 			  		  	 	]WE
