  "bugs": {
    "url": "https://github.com/milamber21-lang/cornmafia/issues"
  },
  "homepage": "https://github.com/milamber21-lang/cornmafia#readme",
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@next/eslint-plugin-next": "^16.2.4",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "comment-parser": "^1.4.1",
    "eslint": "^9.38.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "fs-extra": "^11.3.2",
    "globby": "^15.0.0",
    "globals": "^15.12.0",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.46.2"
  }
}
