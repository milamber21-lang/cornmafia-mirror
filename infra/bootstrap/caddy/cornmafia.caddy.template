# FILE: infra/bootstrap/caddy/cornmafia.caddy.template
# Language: Caddyfile
# Corn Mafia Caddy site template rendered by scripts/bootstrap-deploy.sh.

# CornMafia - Web
{{CM_CADDY_DOMAIN}}, www.{{CM_CADDY_DOMAIN}} {
	encode zstd gzip

	request_body {
		max_size {{CM_CADDY_REQUEST_BODY_MAX_SIZE}}
	}

	header {
		defer
		-X-Powered-By
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
	}

	reverse_proxy {{CM_CADDY_UPSTREAM_HOST}}:{{CM_CADDY_UPSTREAM_PORT}}
}
