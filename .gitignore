# FILE: .gitignore
# Language: Gitignore
# Repository exclusions for local secrets, generated artifacts, support bundles, and runtime data.

# dependencies and builds
node_modules/
apps/web/node_modules/
.pnpm-store/
.turbo/
.next/
**/.next/
dist/
**/dist/
build/
**/build/
coverage/
**/coverage/

# data, logs, and uploaded/generated assets
/data/
logs/
uploads/
*.log
apps/web/public/tiles/

# env files
.env
**/.env
**/*.env
!.env.example
!**/.env.example
!example.env
!**/example.env

# SQL dumps, database backups, and generated review/support archives
cm_web.sql
*.sql
**/*.sql
*.dump
**/*.dump
*.backup
**/*.backup
*.tar
**/*.tar
*.tar.gz
**/*.tar.gz
*.tgz
**/*.tgz
*.zip
**/*.zip
review_diff_*/
review_diff_*.tgz
support/_snapshot.txt
support/_filelist.txt
scripts/game-maps.txt

# key material
mirror_key
mirror_key.pub
*.key
**/*.key
*.pem
**/*.pem
*.p12
**/*.p12
*.pfx
**/*.pfx

# misc
.DS_Store
.vscodelogs/

# keep canonical bootstrap SQL in repo
!/infra/
!/infra/bootstrap/
!/infra/bootstrap/sql/
!/infra/bootstrap/sql/*.sql
!/infra/bootstrap/scripts/
!/infra/bootstrap/scripts/*.sql
