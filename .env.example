# FILE: .env.example
# Language: ENV
# Corn Mafia deployment environment template. Copy to .env and replace every __GENERATE__ value.

# =====================================================================================================================
# Runtime mode
# =====================================================================================================================
NODE_ENV=production


# =====================================================================================================================
# Docker Compose identity and runtime names
# COMPOSE_PROJECT_NAME controls the Compose project namespace.
# Container and network names can be changed safely.
# Compose service keys stay cm-db and cm-web in docker-compose.yml; change CM_*_SERVICE_NAME only if you also rename those keys.
# CM_DB_NETWORK_ALIAS and CM_WEB_NETWORK_ALIAS are stable in-network DNS names. Keep CM_DB_NETWORK_ALIAS=cm-db unless WEB_DATABASE_URL is also changed.
# =====================================================================================================================
COMPOSE_PROJECT_NAME=cm
CM_DB_SERVICE_NAME=cm-db
CM_WEB_SERVICE_NAME=cm-web
CM_DB_CONTAINER_NAME=cm-db
CM_WEB_CONTAINER_NAME=cm-web
CM_DB_NETWORK_ALIAS=cm-db
CM_WEB_NETWORK_ALIAS=cm-web
CM_NETWORK_NAME=cm-internal
CM_DB_IMAGE=postgres:16-alpine@sha256:4e6e670bb069649261c9c18031f0aded7bb249a5b6664ddec29c013a89310d50
CM_WEB_IMAGE_NAME=cm-web:local
CM_BOOTSTRAP_DIR=./infra/bootstrap

# =====================================================================================================================
# Web host/container port mapping
# WEB_INTERNAL_PORT is the port Next.js listens on inside cm-web.
# WEB_EXTERNAL_PORT is the host port exposed to Caddy on WEB_HOST_BIND.
# PORT is kept for Next.js/runtime compatibility and should match WEB_INTERNAL_PORT.
# =====================================================================================================================
WEB_HOST_BIND=127.0.0.1
WEB_INTERNAL_PORT=5323
WEB_EXTERNAL_PORT=5323
PORT=5323

# =====================================================================================================================
# Web container runtime identity
# These must match the host ownership used for writable mounted folders.
# Default matches apps/web/Dockerfile. Change both only if your deployment policy requires it.
# =====================================================================================================================
CM_WEB_UID=10001
CM_WEB_GID=10001

# =====================================================================================================================
# Public/internal web addresses
# WEB_PUBLIC_URL seeds Caddy domain setup during scripts/bootstrap-deploy.sh.
# =====================================================================================================================
WEB_INTERNAL_URL=http://cm-web:5323
WEB_PUBLIC_URL=https://example.cornmafia.local
NEXTAUTH_URL=https://example.cornmafia.local
NEXT_PUBLIC_BASE_URL=https://example.cornmafia.local

# =====================================================================================================================
# Required generated secrets
# =====================================================================================================================
NEXTAUTH_SECRET=__GENERATE_64_PLUS_CHARACTER_SECRET__
REVALIDATE_TOKEN=__GENERATE_64_PLUS_CHARACTER_SECRET__

# =====================================================================================================================
# Discord OAuth and bot integration
# =====================================================================================================================
DISCORD_CLIENT_ID=__DISCORD_APPLICATION_CLIENT_ID__
DISCORD_CLIENT_SECRET=__DISCORD_CLIENT_SECRET__
DISCORD_BOT_TOKEN=__DISCORD_BOT_TOKEN__
DISCORD_GUILD_ID=__DISCORD_GUILD_ID__

# =====================================================================================================================
# Optional external APIs
# =====================================================================================================================
YOUTUBE_DATA_API_KEY=
GOOGLE_YOUTUBE_DATA_API_KEY=

# =====================================================================================================================
# PostgreSQL container bootstrap owner role
# This owner / migration role is only for the database container and operator scripts.
# The web runtime must never connect with this role.
# =====================================================================================================================
POSTGRES_USER=cm
POSTGRES_PASSWORD=__GENERATE_OWNER_DB_PASSWORD__
POSTGRES_DB=cm_web
POSTGRES_HOST_BIND=127.0.0.1
POSTGRES_EXTERNAL_PORT=5432
# Local bootstrap/operator scripts connect through these host values.
CM_POSTGRES_HOST=127.0.0.1
CM_POSTGRES_PORT=5432
POSTGRES_PORT_BIND=127.0.0.1:5432
POSTGRES_DATA_DIR=./data/postgres
POSTGRES_INIT_DIR=./infra/postgres-init

# =====================================================================================================================
# PostgreSQL runtime app role
# Create this role in deployment SQL. The web app must connect with this user.
# =====================================================================================================================
CM_CLIENT_DB_USER=cm_client
CM_CLIENT_DB_PASSWORD=__GENERATE_RUNTIME_DB_PASSWORD__
WEB_DATABASE_URL=postgresql://cm_client:__GENERATE_RUNTIME_DB_PASSWORD__@cm-db:5432/cm_web
DATABASE_URL=${WEB_DATABASE_URL}

# Owner connection string for local operator scripts only.
# docker-compose.yml does not pass this value into cm-web.
CM_OWNER_DATABASE_URL=postgresql://cm:__GENERATE_OWNER_DB_PASSWORD__@cm-db:5432/cm_web

# =====================================================================================================================
# Media/cache paths
# =====================================================================================================================
WEB_MEDIA_ROOT=/app/data/media
WEB_CACHE_ROOT=/app/.next/cache
WEB_CACHE_HOST_DIR=./data/web_cache
WEB_MEDIA_HOST_DIR=./data/media

# =====================================================================================================================
# Container resource and log limits
# =====================================================================================================================
WEB_PIDS_LIMIT=256
WEB_CPUS=2.0
WEB_MEM_LIMIT=2g
WEB_TMP_SIZE=128m
WEB_RUN_SIZE=16m
LOG_MAX_SIZE=10m
LOG_MAX_FILE=5

# =====================================================================================================================
# Optional map/tile/public asset roots
# =====================================================================================================================
CM_TILES_ROOT=
CM_PUBLIC_ROOT=

# =====================================================================================================================
# Feature flags
# =====================================================================================================================
FEATURE_WALLETS=false
FEATURE_MAPS=false
